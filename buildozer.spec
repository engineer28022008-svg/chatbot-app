[app]

# (str) Title of your app
title = MyChatbot

# (str) Package name
package.name = mychatbot

# (str) Package domain (use any valid format)
package.domain = org.example

# (list) Source files to include
source.include_exts = py,json

# (list) Application requirements
requirements = python3,kivy

# (str) Orientation
orientation = portrait

# (bool) Indicate if the app should be fullscreen
fullscreen = 0

# (list) Permissions needed by your app (optional)
android.permissions = INTERNET

# (str) Icon of the app (optional)
# icon.filename = icon.png

# (str) Supported platforms
osx.python_version = 3.10